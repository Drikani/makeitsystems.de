source "https://rubygems.org"
ruby '>= 3.1'

# This will help ensure the proper Jekyll version is running.
gem "jekyll", "~> 4.4"

# Liefert Bootstraps Sass-Quellen als Gem statt vendorter Dateien im Repo
# (siehe _plugins/bootstrap_sass.rb, das den Sass-Load-Path registriert).
gem 'bootstrap', '~> 5.3'

# Liefert Font-Awesome-Sass-Quellen und die Font-Dateien selbst als Gem statt
# über den Google-Fonts-Link (siehe _plugins/font_awesome_sass.rb).
gem 'font-awesome-sass', '~> 6.7'

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: [:windows, :jruby]

